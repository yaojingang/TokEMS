{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", ".nuxt/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false,
      "passThroughEnv": [
        "BATCH_TEST_DATABASE_URL",
        "INVOICE_SMS_TEST_DATABASE_URL",
        "INVOICE_SMS_TEST_REDIS_URL"
      ]
    }
  }
}
