{
  "name": "@conference/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src --passWithNoTests",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "repair-registration-identities": "tsx src/repair-registration-identities.ts",
    "migrate:template-domain": "tsx src/migrate-template-domain.ts",
    "canonical:export": "tsx src/export-canonical-homepage.ts --write",
    "canonical:check": "tsx src/export-canonical-homepage.ts --check",
    "canonical:verify": "tsx src/export-canonical-homepage.ts --verify-file",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@conference/contracts": "workspace:*",
    "@conference/html-template": "workspace:*",
    "@conference/security": "workspace:*",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
