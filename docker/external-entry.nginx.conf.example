# TokEMS external Nginx (host) — three sites → Gateway 127.0.0.1:8088
#
# DNS:
#   hui.ailingdaoli.com          → conference + stable WeChat notify API
#   admin.hui.ailingdaoli.com    → admin console (/admin/)
#   www.ailingdaoli.com          → WeChat payment surface only (/pay/hui/)
#
# Replace certificate paths before production use.

upstream tokems_gateway {
  server 127.0.0.1:8088;
  keepalive 32;
}

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# ---------- 大会主站（PUBLIC_ORIGIN）----------
server {
  listen 80;
  listen [::]:80;
  server_name hui.ailingdaoli.com;
  location ~ ^/(invoice/file/|api/v1/invoice-files/|pay/hui/api/v1/invoice-files/) {
    access_log off;
    error_log /dev/null crit;
    add_header Referrer-Policy "no-referrer" always;
    return 404;
  }
  location / { return 301 https://$host$request_uri; }
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name hui.ailingdaoli.com;

  ssl_certificate     /etc/ssl/certs/hui.ailingdaoli.com.fullchain.pem;
  ssl_certificate_key /etc/ssl/private/hui.ailingdaoli.com.key;

  client_max_body_size 20m;
  proxy_read_timeout 60s;
  proxy_send_timeout 60s;

  set_real_ip_from 10.0.0.0/8;
  set_real_ip_from 172.16.0.0/12;
  set_real_ip_from 192.168.0.0/16;
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;

  location ^~ /pay/hui/api/v1/invoice-files/ {
    access_log off;
    error_log /dev/null crit;
    add_header Referrer-Policy "no-referrer" always;
    return 404;
  }

  location ~ ^/(invoice/file/|api/v1/invoice-files/) {
    proxy_hide_header Referrer-Policy;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    access_log off;
    error_log /dev/null crit;
    proxy_pass http://tokems_gateway;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Referer "";
    proxy_buffering off;
  }

  location / {
    proxy_pass http://tokems_gateway;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}

# ---------- 运营后台（ADMIN_ORIGIN，独立站点）----------
server {
  listen 80;
  listen [::]:80;
  server_name admin.hui.ailingdaoli.com;
  location ~ ^/(invoice/file/|api/v1/invoice-files/|pay/hui/api/v1/invoice-files/) {
    access_log off;
    error_log /dev/null crit;
    add_header Referrer-Policy "no-referrer" always;
    return 404;
  }
  location / { return 301 https://$host$request_uri; }
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name admin.hui.ailingdaoli.com;

  ssl_certificate     /etc/ssl/certs/admin.hui.ailingdaoli.com.fullchain.pem;
  ssl_certificate_key /etc/ssl/private/admin.hui.ailingdaoli.com.key;

  client_max_body_size 20m;
  proxy_read_timeout 60s;
  proxy_send_timeout 60s;

  set_real_ip_from 10.0.0.0/8;
  set_real_ip_from 172.16.0.0/12;
  set_real_ip_from 192.168.0.0/16;
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;

  location ^~ /pay/hui/api/v1/invoice-files/ {
    access_log off;
    error_log /dev/null crit;
    add_header Referrer-Policy "no-referrer" always;
    return 404;
  }

  location ~ ^/(invoice/file/|api/v1/invoice-files/) {
    proxy_hide_header Referrer-Policy;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    access_log off;
    error_log /dev/null crit;
    proxy_pass http://tokems_gateway;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Referer "";
    proxy_buffering off;
  }

  location / {
    proxy_pass http://tokems_gateway;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}

# ---------- 支付入口（PAYMENT_PUBLIC_*，只开放 /pay/hui）----------
server {
  listen 80;
  listen [::]:80;
  server_name www.ailingdaoli.com;
  # If www already has other sites, only add the /pay/hui location into that existing HTTPS server.
  location ~ ^/(invoice/file/|api/v1/invoice-files/|pay/hui/api/v1/invoice-files/) {
    access_log off;
    error_log /dev/null crit;
    add_header Referrer-Policy "no-referrer" always;
    return 404;
  }
  location / { return 301 https://$host$request_uri; }
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name www.ailingdaoli.com;

  ssl_certificate     /etc/ssl/certs/www.ailingdaoli.com.fullchain.pem;
  ssl_certificate_key /etc/ssl/private/www.ailingdaoli.com.key;

  client_max_body_size 2m;
  proxy_read_timeout 60s;
  proxy_send_timeout 60s;

  set_real_ip_from 10.0.0.0/8;
  set_real_ip_from 172.16.0.0/12;
  set_real_ip_from 192.168.0.0/16;
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;

  location = /pay/hui {
    return 308 https://www.ailingdaoli.com/pay/hui/;
  }

  location ^~ /pay/hui/api/v1/invoice-files/ {
    access_log off;
    error_log /dev/null crit;
    add_header Referrer-Policy "no-referrer" always;
    return 404;
  }

  location ^~ /pay/hui/ {
    proxy_pass http://tokems_gateway;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Referer $http_referer;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }

  # Keep other www paths on the existing site / 404 as appropriate.
  # location / { ... }
}
