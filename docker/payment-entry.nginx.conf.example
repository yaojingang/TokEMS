# Example external Nginx entry for the WeChat payment surface.
#
# Requirements:
# - JSAPI authorize directory: https://www.ailingdaoli.com/pay/
# - Payment app surface: https://www.ailingdaoli.com/pay/hui/
# - Conference site remains on https://hui.ailingdaoli.com
# - Stable WeChat notify stays on https://hui.ailingdaoli.com/api/v1/payments/wechat/notify/{orgId}
#
# Replace upstream address, certificates, and real_ip CIDR before production use.

upstream tokems_gateway {
  server 127.0.0.1:8088;
  keepalive 32;
}

map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name www.ailingdaoli.com;

  ssl_certificate     /etc/ssl/certs/www.ailingdaoli.com.fullchain.pem;
  ssl_certificate_key /etc/ssl/private/www.ailingdaoli.com.key;

  client_max_body_size 2m;
  proxy_read_timeout 60s;
  proxy_send_timeout 60s;

  # Preserve client IP for H5 payer_client_ip resolution inside TokEMS.
  set_real_ip_from 10.0.0.0/8;
  set_real_ip_from 172.16.0.0/12;
  set_real_ip_from 192.168.0.0/16;
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;

  location = /pay/hui {
    return 308 https://www.ailingdaoli.com/pay/hui/;
  }

  location ^~ /pay/hui/api/v1/invoice-files/ {
    access_log off;
    error_log /dev/null crit;
    add_header Referrer-Policy "no-referrer" always;
    return 404;
  }

  location ^~ /pay/hui/ {
    proxy_pass http://tokems_gateway;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    # Keep Referer intact for WeChat H5 domain checks.
    proxy_set_header Referer $http_referer;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }

  # Do not proxy unrelated www paths into TokEMS.
  location / {
    return 404;
  }
}
