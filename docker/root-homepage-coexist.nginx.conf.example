# Place these locations inside the existing conference HTTPS server.
# Replace its existing location / with the last block below.
# Enable "不设置页面" in TokEMS before giving the root to this static site.
# Keep the existing TLS, request-size, invoice-file, and payment settings.
# The index.html file must reference assets under /site-home-assets/.

location = / {
  error_page 418 = @tokems_legacy_root;
  if ($arg_event != "") { return 418; }
  root /www/wwwroot/tokems-site-home;
  try_files /index.html =404;
}

location @tokems_legacy_root {
  proxy_pass http://127.0.0.1:8088;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
}

location ^~ /site-home-assets/ {
  root /www/wwwroot/tokems-site-home;
  try_files $uri =404;
}

location / {
  proxy_pass http://127.0.0.1:8088;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
}
